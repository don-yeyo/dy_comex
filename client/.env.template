# AUTENTICACIÓN MICROSOFT (AZURE AD)
VITE_AZURE_CLIENT_ID=tu_client_id_aqui
VITE_AZURE_TENANT_ID=tu_tenant_id_aqui

# CONFIGURACIÓN DE LA APLICACIÓN
# Nombre de la empresa (se muestra en el drawer/footer)
VITE_COMPANY_NAME=DON YEYO S.A.
# Versión de la aplicación (ej: 1.0.0)
VITE_APP_VERSION=1.0.0
# Nombre de la aplicación
VITE_APP_NAME=ComEx CRM
# Puerto del servidor de desarrollo del cliente (ej: 3000)
VITE_DEV_PORT=3000
# URL base de la API backend, sin /api (ej: http://localhost:5000)
VITE_API_URL=http://localhost:5000
# Mostrar mensajes de error detallados del servidor en Toasts (true/false)
VITE_SHOW_DETAILED_ERRORS=true
# Nombre del usuario por defecto (fallback sin autenticación)
VITE_DEFAULT_USER_NAME=Usuario
# Email del usuario por defecto
VITE_DEFAULT_USER_EMAIL=usuario@empresa.com
